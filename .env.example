# Copy to .env. Leave everything empty and keep SAMPLE_MODE=true to run offline with no keys.

# --- Runtime -----------------------------------------------------------------
SAMPLE_MODE=true
LOG_LEVEL=INFO
AGENT_PORT=8000
COGNITION_PORT=8100
COGNITION_URL=http://cognition:8100
# H-MEM memory (ADR-0005): warm = recall lessons, let the critic judge them, store the run's lesson behind
# the memory gate; cold = no memory call. Default for requests that name no options.memory; off = cold for every run.
MEMORY_MODE=warm
MEMORY_NAMESPACE=lessons            # H-MEM namespace for lessons
COGNITION_TIMEOUT_S=10              # per cognition call; down = run without memory (one degraded line)
HITL_MODE=auto                      # auto | interactive | scripted
MAX_CAUSAL_DEPTH=5
MAX_BRANCHES_PER_LEVEL=3
MAX_NEW_SOURCES_PER_RUN=2
MAX_OVER_EXPLAINED=1.5             # Loop B: an add-back explaining more than this share of the change is pruned (likely wrong match)
RUN_BUDGET_SECONDS=600              # wall-clock budget per run; POST /run waits this + 30 s
RUNS_REGISTRY_SIZE=50               # runs kept in memory for GET /runs/{id} (oldest finished evicted)
MAX_CONCURRENT_RUNS=4               # more concurrent runs get a structured 429
# CORS is off while this is empty; set comma-separated origins for a browser UI on another origin.
CORS_ALLOW_ORIGINS=

# --- Data: Zetaris (live mode) -------------------------------------------------
# From inside Docker on macOS/Windows use host.docker.internal; from the host use localhost.
ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
SOURCE_TIMEOUT_SECONDS=20
MAX_RETRIES=2
# Zetaris loses its CACHE TABLE cache on restart (BACKLOG B-20). In live mode the API re-caches the
# ZETARIS_WARM_ENTITIES' raw tables in the background on start (GET /health: zetaris_cache); sample mode
# ignores this.
# By hand: cd services/agent && uv run python -m tiresias_agent.adapters.zetaris warm
ZETARIS_WARM_ON_START=true
ZETARIS_WARM_TIMEOUT_SECONDS=120   # per CACHE TABLE statement (a cold SEC refetch can pass the 20 s source timeout)
ZETARIS_WARM_BUDGET_SECONDS=600    # whole warm pass; later tables are skipped
ZETARIS_WARM_MAX_TABLES=11         # cached companyfacts use driver heap: all 63 tables ran a 2 GB heap out of memory (B-24)
# Warmed first, in this order (facts, then submissions, per entity), then the ticker map, then the rest.
# Comma-separated object tickers as adapters.zetaris.object_ticker names them (BRK-B -> brkb).
ZETARIS_WARM_ENTITIES=mmm,solv,ge,gehc,gev
# Each cached companyfacts table holds ~150 MB of Zetaris driver heap (B-24). At most this many stay
# cached (1..50); before caching one more, the least recently used one not needed by a running run is
# uncached (UNCACHE TABLE; never dropped). warm counts toward it too.
ZETARIS_MAX_CACHED_FACTS=5
# Liveness probe before a live run (SELECT 1 AS alive, no retry); a dead or unreachable engine sends the
# run straight to the offline sample. Result reused for the TTL (0..600 s; 0 = every run). GET /health: zetaris.
ZETARIS_LIVENESS_TIMEOUT_SECONDS=3
ZETARIS_LIVENESS_TTL_SECONDS=30

# --- Models: Meterless Nightshift (live mode) ----------------------------------
# The NVIDIA key lives in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=tiresias
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
MODEL_TIMEOUT_SECONDS=180
# Investigation depth (ADR-0011) is chosen per request (options.depth: quick = rules only, the default;
# thorough = + the critic's model second opinion, ~1.5 min more; deep = every model lane, ~2.5 min more).
# MODEL_LANES is the operator override: auto = the request decides; on = deep when the request names no
# depth; off = rules only at every depth. Sample mode never calls a model.
MODEL_LANES=auto
MAX_MODEL_CALLS_PER_RUN=12

# --- Hosted demo deploy (deploy/gcp/deploy.sh only; the app never reads these) ------
# GCP_PROJECT=your-gcp-project-id
# GCP_REGION=australia-southeast1

# --- SEC fair-access policy (sample refresh and Zetaris REST tables) -----------
SEC_USER_AGENT=Tiresias your-contact-email@example.com
