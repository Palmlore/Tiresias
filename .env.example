# Copy to .env. Leave everything empty and keep SAMPLE_MODE=true to run offline with no keys.

# --- Runtime -----------------------------------------------------------------
SAMPLE_MODE=true
LOG_LEVEL=INFO
AGENT_PORT=8000
COGNITION_PORT=8100
COGNITION_URL=http://cognition:8100
HITL_MODE=auto                      # auto | interactive | scripted
MAX_CAUSAL_DEPTH=5
MAX_BRANCHES_PER_LEVEL=3
MAX_NEW_SOURCES_PER_RUN=2
MAX_OVER_EXPLAINED=1.5             # Loop B: an add-back explaining more than this share of the change is pruned (likely wrong match)
RUN_BUDGET_SECONDS=600              # wall-clock budget per run; POST /run waits this + 30 s
RUNS_REGISTRY_SIZE=50               # runs kept in memory for GET /runs/{id} (oldest finished evicted)
MAX_CONCURRENT_RUNS=4               # more concurrent runs get a structured 429
# CORS is off while this is empty; set comma-separated origins for a browser UI on another origin.
CORS_ALLOW_ORIGINS=

# --- Data: Zetaris (live mode) -------------------------------------------------
# From inside Docker on macOS/Windows use host.docker.internal; from the host use localhost.
ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
SOURCE_TIMEOUT_SECONDS=20
MAX_RETRIES=2

# --- Models: Meterless Nightshift (live mode) ----------------------------------
# The NVIDIA key lives in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=tiresias
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
MODEL_TIMEOUT_SECONDS=180
# Investigation depth (ADR-0011) is chosen per request (options.depth: quick = rules only, the default;
# thorough = + the critic's model second opinion, ~1.5 min more; deep = every model lane, ~2.5 min more).
# MODEL_LANES is the operator override: auto = the request decides; on = deep when the request names no
# depth; off = rules only at every depth. Sample mode never calls a model.
MODEL_LANES=auto
MAX_MODEL_CALLS_PER_RUN=12

# --- SEC fair-access policy (sample refresh and Zetaris REST tables) -----------
SEC_USER_AGENT=Tiresias your-contact-email@example.com
